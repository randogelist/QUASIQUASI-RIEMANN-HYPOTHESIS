import Mathlib

namespace GPBKQRKernel

/-- Canonical positive base-2 scale, written through exp/log so all group
identities are transparent and independent of any spectral hypothesis. -/
noncomputable def dyadicScale (x : ℝ) : ℝ :=
  Real.exp (Real.log 2 * x)

/-- The centered real coordinate. -/
noncomputable def centered (sigma : ℝ) : ℝ := sigma - (1 / 2 : ℝ)

/-- Reflection across the distinguished center `1/2`. -/
def reflect (sigma : ℝ) : ℝ := 1 - sigma

/-- Phase-free dyadic gain. -/
noncomputable def phaseFreeGain (sigma : ℝ) : ℝ :=
  dyadicScale (2 * centered sigma)

/-- The reciprocal-symmetric contraction generated by the phase-free gain. -/
noncomputable def symmetricContraction (sigma : ℝ) : ℝ :=
  let g := phaseFreeGain sigma
  4 * g / (1 + g) ^ 2

/-- The dual Cayley eigenvalue associated with the same positive gain. -/
noncomputable def dualCayleyEigenvalue (sigma : ℝ) : ℝ :=
  let g := phaseFreeGain sigma
  (2 + g + g⁻¹) / 4

/-- Base-2 scale is positive. -/
theorem dyadicScale_pos (x : ℝ) : 0 < dyadicScale x := by
  exact Real.exp_pos _

/-- Base-2 scale at zero is one. -/
theorem dyadicScale_zero : dyadicScale 0 = 1 := by
  simp [dyadicScale]

/-- Exact additive group law for scale. -/
theorem dyadicScale_add (x y : ℝ) :
    dyadicScale (x + y) = dyadicScale x * dyadicScale y := by
  simp [dyadicScale, mul_add, Real.exp_add]

/-- Exact reciprocal law. -/
theorem dyadicScale_neg (x : ℝ) :
    dyadicScale (-x) = (dyadicScale x)⁻¹ := by
  simp [dyadicScale, Real.exp_neg]

/-- Base-2 scale is strictly increasing. -/
theorem dyadicScale_strictMono : StrictMono dyadicScale := by
  intro x y hxy
  unfold dyadicScale
  apply Real.exp_lt_exp.mpr
  have hlog : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  exact mul_lt_mul_of_pos_left hxy hlog

/-- Scale takes the value one only at exponent zero. -/
theorem dyadicScale_eq_one_iff (x : ℝ) :
    dyadicScale x = 1 ↔ x = 0 := by
  constructor
  · intro h
    by_contra hx
    rcases lt_or_gt_of_ne hx with hlt | hgt
    · have hs := dyadicScale_strictMono hlt
      rw [dyadicScale_zero, h] at hs
      exact (lt_irrefl (1 : ℝ)) hs
    · have hs := dyadicScale_strictMono hgt
      rw [dyadicScale_zero, h] at hs
      exact (lt_irrefl (1 : ℝ)) hs
  · intro h
    simpa [h] using dyadicScale_zero

/-- Reflection negates the centered coordinate. -/
theorem centered_reflect (sigma : ℝ) :
    centered (reflect sigma) = - centered sigma := by
  unfold centered reflect
  ring

/-- The reflected phase-free gain is exactly reciprocal. -/
theorem phaseFreeGain_reflect (sigma : ℝ) :
    phaseFreeGain (reflect sigma) = (phaseFreeGain sigma)⁻¹ := by
  change dyadicScale (2 * centered (reflect sigma)) =
    (dyadicScale (2 * centered sigma))⁻¹
  rw [centered_reflect]
  have harg : 2 * (-centered sigma) = -(2 * centered sigma) := by ring
  rw [harg, dyadicScale_neg]

/-- The phase-free gain is strictly positive. -/
theorem phaseFreeGain_pos (sigma : ℝ) : 0 < phaseFreeGain sigma := by
  exact dyadicScale_pos _

/-- Reflection produces an exact multiplicative inverse pair. -/
theorem phaseFreeGain_mul_reflect (sigma : ℝ) :
    phaseFreeGain sigma * phaseFreeGain (reflect sigma) = 1 := by
  rw [phaseFreeGain_reflect]
  have hne : phaseFreeGain sigma ≠ 0 := ne_of_gt (phaseFreeGain_pos sigma)
  field_simp [hne]

/-- The gain is at most one exactly on the left side of the center. -/
theorem phaseFreeGain_le_one_iff (sigma : ℝ) :
    phaseFreeGain sigma ≤ 1 ↔ sigma ≤ (1 / 2 : ℝ) := by
  constructor
  · intro hg
    by_contra hs
    have hright : (1 / 2 : ℝ) < sigma := lt_of_not_ge hs
    have hexp : 0 < 2 * centered sigma := by
      unfold centered
      linarith
    have hstrict : dyadicScale 0 < dyadicScale (2 * centered sigma) :=
      dyadicScale_strictMono hexp
    rw [dyadicScale_zero] at hstrict
    unfold phaseFreeGain at hg
    linarith
  · intro hs
    have hexp : 2 * centered sigma ≤ 0 := by
      unfold centered
      linarith
    have hmono := dyadicScale_strictMono.monotone hexp
    rw [dyadicScale_zero] at hmono
    simpa [phaseFreeGain] using hmono

/-- The gain equals one exactly at the center. -/
theorem phaseFreeGain_eq_one_iff (sigma : ℝ) :
    phaseFreeGain sigma = 1 ↔ sigma = (1 / 2 : ℝ) := by
  unfold phaseFreeGain
  rw [dyadicScale_eq_one_iff]
  unfold centered
  constructor <;> intro h <;> linarith

/-- Exact logarithm of the phase-free gain. -/
theorem log_phaseFreeGain (sigma : ℝ) :
    Real.log (phaseFreeGain sigma) = Real.log 2 * (2 * centered sigma) := by
  simp [phaseFreeGain, dyadicScale]

/-- Symmetric contraction is strictly positive. -/
theorem symmetricContraction_pos (sigma : ℝ) :
    0 < symmetricContraction sigma := by
  unfold symmetricContraction
  have hg : 0 < phaseFreeGain sigma := phaseFreeGain_pos sigma
  positivity

/-- Symmetric contraction is at most one. -/
theorem symmetricContraction_le_one (sigma : ℝ) :
    symmetricContraction sigma ≤ 1 := by
  unfold symmetricContraction
  let g := phaseFreeGain sigma
  have hg : 0 < g := by
    dsimp [g]
    exact phaseFreeGain_pos sigma
  have hden : 0 < (1 + g) ^ 2 := by positivity
  apply (div_le_iff₀ hden).2
  nlinarith [sq_nonneg (g - 1)]

/-- Exact positive-square complement identity. -/
theorem one_sub_symmetricContraction (sigma : ℝ) :
    1 - symmetricContraction sigma =
      ((phaseFreeGain sigma - 1) / (phaseFreeGain sigma + 1)) ^ 2 := by
  unfold symmetricContraction
  let g := phaseFreeGain sigma
  have hg : 0 < g := by
    dsimp [g]
    exact phaseFreeGain_pos sigma
  have hsum : g + 1 ≠ 0 := by linarith
  have hden : (g + 1) ^ 2 ≠ 0 := pow_ne_zero 2 hsum
  change 1 - 4 * g / (1 + g) ^ 2 = ((g - 1) / (g + 1)) ^ 2
  rw [show (1 + g) ^ 2 = (g + 1) ^ 2 by ring]
  calc
    1 - 4 * g / (g + 1) ^ 2 =
        (g + 1) ^ 2 / (g + 1) ^ 2 - 4 * g / (g + 1) ^ 2 := by
          rw [div_self hden]
    _ = ((g + 1) ^ 2 - 4 * g) / (g + 1) ^ 2 := by
          rw [sub_div]
    _ = (g - 1) ^ 2 / (g + 1) ^ 2 := by
          congr 1
          ring
    _ = ((g - 1) / (g + 1)) ^ 2 := by
          rw [div_pow]

/-- The symmetric contraction is reflection-invariant. -/
theorem symmetricContraction_reflect (sigma : ℝ) :
    symmetricContraction (reflect sigma) = symmetricContraction sigma := by
  unfold symmetricContraction
  rw [phaseFreeGain_reflect]
  let g := phaseFreeGain sigma
  have hg : 0 < g := by
    dsimp [g]
    exact phaseFreeGain_pos sigma
  have hgne : g ≠ 0 := ne_of_gt hg
  have hsum : g + 1 ≠ 0 := by linarith
  change 4 * g⁻¹ / (1 + g⁻¹) ^ 2 = 4 * g / (1 + g) ^ 2
  have hinvsum : 1 + g⁻¹ ≠ 0 := by
    have hginv : 0 < g⁻¹ := inv_pos.mpr hg
    linarith
  field_simp [hgne, hsum, hinvsum]
  ring

/-- The symmetric contraction reaches one exactly at the center. -/
theorem symmetricContraction_eq_one_iff (sigma : ℝ) :
    symmetricContraction sigma = 1 ↔ sigma = (1 / 2 : ℝ) := by
  constructor
  · intro hq
    have hcomp := one_sub_symmetricContraction sigma
    rw [hq] at hcomp
    have hsquare :
        ((phaseFreeGain sigma - 1) / (phaseFreeGain sigma + 1)) ^ 2 = 0 := by
      linarith
    have hratio :
        (phaseFreeGain sigma - 1) / (phaseFreeGain sigma + 1) = 0 := by
      nlinarith
    have hden : phaseFreeGain sigma + 1 ≠ 0 := by
      have hg := phaseFreeGain_pos sigma
      linarith
    have hg1 : phaseFreeGain sigma = 1 := by
      apply sub_eq_zero.mp
      exact (div_eq_zero_iff.mp hratio).resolve_right hden
    exact (phaseFreeGain_eq_one_iff sigma).1 hg1
  · intro hs
    subst sigma
    norm_num [symmetricContraction, phaseFreeGain, centered, dyadicScale]

/-- Exact dual-minus-one positive-square identity. -/
theorem dualCayleyEigenvalue_sub_one (sigma : ℝ) :
    dualCayleyEigenvalue sigma - 1 =
      (phaseFreeGain sigma - 1) ^ 2 / (4 * phaseFreeGain sigma) := by
  unfold dualCayleyEigenvalue
  let g := phaseFreeGain sigma
  have hg : 0 < g := by
    dsimp [g]
    exact phaseFreeGain_pos sigma
  have hgne : g ≠ 0 := ne_of_gt hg
  change (2 + g + g⁻¹) / 4 - 1 = (g - 1) ^ 2 / (4 * g)
  field_simp [hgne]
  ring

/-- The dual Cayley eigenvalue is always at least one. -/
theorem one_le_dualCayleyEigenvalue (sigma : ℝ) :
    1 ≤ dualCayleyEigenvalue sigma := by
  have hid := dualCayleyEigenvalue_sub_one sigma
  have hg : 0 < phaseFreeGain sigma := phaseFreeGain_pos sigma
  have hnonneg :
      0 ≤ (phaseFreeGain sigma - 1) ^ 2 / (4 * phaseFreeGain sigma) := by
    positivity
  linarith

/-- The positive contraction and dual Cayley eigenvalue are exact reciprocals. -/
theorem symmetricContraction_mul_dualCayleyEigenvalue (sigma : ℝ) :
    symmetricContraction sigma * dualCayleyEigenvalue sigma = 1 := by
  unfold symmetricContraction dualCayleyEigenvalue
  let g := phaseFreeGain sigma
  have hg : 0 < g := by
    dsimp [g]
    exact phaseFreeGain_pos sigma
  have hgne : g ≠ 0 := ne_of_gt hg
  have hsum : g + 1 ≠ 0 := by linarith
  change (4 * g / (1 + g) ^ 2) * ((2 + g + g⁻¹) / 4) = 1
  field_simp [hgne, hsum]
  ring

end GPBKQRKernel
