import Derivations.GP.FreeEnergyCurvature
import Derivations.GP.CayleyObservable

namespace NativeSolobolo.Derivations.GP

open NativeSolobolo
open NativeSolobolo.Derivations.BKQR

/-- !!! Equal base functions give identical definitionally generated Widder towers. -/
theorem BASE_EQUALITY_IMPLIES_WIDDER_TOWER_EQUALITY
    (f g : ℝ → ℝ)
    (hfg : f = g) :
    ∀ n : Nat, widderTower f n = widderTower g n := by
  intro n
  rw [hfg]

/--
!!! BASE CURVATURE -> ALL COMMON MOMENTS, with no shared-recursion hypothesis.
Both towers are generated by the same explicit definition `widderTower`.
-/
theorem FREE_ENERGY_CURVATURE_IMPLIES_COMMON_MOMENTS
    {BKVec Value : Type}
    {G : GPObservable Value}
    {QBKQR : ScalarProductGeometry ℝ BKVec}
    {C : CayleyMomentCodec ℝ Value}
    (A : GPWidderGeneratedModel G C)
    (M : BKQRWidderGeneratedModel BKVec Value QBKQR C)
    (F : GPBKQRFreeEnergyCurvature A M) :
    GPBKQRCommonMomentIdentity A.toTransferMomentModel M.toCayleyModel := by
  have hbase : A.baseMoment = M.baseMoment := by
    funext a
    exact FREE_ENERGY_CURVATURE_IMPLIES_BASE_MOMENT_EQUALITY A M F a
  refine ⟨?_⟩
  intro a n
  change widderTower A.baseMoment n a = widderTower M.baseMoment n a
  rw [hbase]

end NativeSolobolo.Derivations.GP
