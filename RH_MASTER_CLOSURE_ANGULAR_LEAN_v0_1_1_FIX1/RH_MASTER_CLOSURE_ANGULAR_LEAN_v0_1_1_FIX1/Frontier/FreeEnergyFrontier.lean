import Derivations.BKQR.ScalarProduct
import Frontier.OurFrontier

namespace NativeSolobolo

open Derivations.BKQR

/-- ! Log-scale curvature at anchor `a`. -/
noncomputable def logScaleCurvature (phi : ℝ → ℝ) (a : ℝ) : ℝ :=
  deriv (deriv phi) (Real.log a)

/--
!!! EXPLICIT WIDDER STEP.
If `f = mu_n`, this is the universal differential operator generating `mu_(n+1)`:
  mu_(n+1) = 2/[m(2m+1)] * [m^2 f - a f' - a^2 f''],  m=n+1.
-/
noncomputable def widderStep (n : Nat) (f : ℝ → ℝ) : ℝ → ℝ :=
  fun a =>
    let m : ℝ := (n + 1 : Nat)
    (2 / (m * (2 * m + 1))) *
      (m ^ 2 * f a - a * deriv f a - a ^ 2 * deriv (deriv f) a)

/-- !!! The entire Widder tower generated definitionally from one base moment. -/
noncomputable def widderTower (base : ℝ → ℝ) : Nat → ℝ → ℝ
  | 0 => base
  | n + 1 => widderStep n (widderTower base n)

@[simp] theorem widderTower_zero (base : ℝ → ℝ) :
    widderTower base 0 = base := rfl

@[simp] theorem widderTower_succ (base : ℝ → ℝ) (n : Nat) :
    widderTower base (n + 1) = widderStep n (widderTower base n) := rfl

/--
!! GP model whose moment tower is generated by the explicit Widder recursion.
The reconstruction field is the analytic content tying this generated tower to the
actual GP/Cayley observable.
-/
structure GPWidderGeneratedModel
    {Value : Type}
    (G : GPObservable Value)
    (C : CayleyMomentCodec ℝ Value) where
  baseMoment : ℝ → ℝ
  reconstruct : ∀ a r,
    PositiveAnchor a →
    InteriorRadius r →
    G.eval a r = some (C.decode a r (fun n => widderTower baseMoment n a))

/-- Convert a definitionally Widder-generated GP model to the downstream moment model. -/
noncomputable def GPWidderGeneratedModel.toTransferMomentModel
    {Value : Type}
    {G : GPObservable Value}
    {C : CayleyMomentCodec ℝ Value}
    (A : GPWidderGeneratedModel G C) : GPTransferMomentModel G C where
  moment a n := widderTower A.baseMoment n a
  reconstruct := A.reconstruct

/--
!! BKQR model generated by the same explicit Widder tower, with every coefficient
realized as a Q-square.
-/
structure BKQRWidderGeneratedModel
    (BKVec Value : Type)
    (Q : ScalarProductGeometry ℝ BKVec)
    (C : CayleyMomentCodec ℝ Value) where
  baseMoment : ℝ → ℝ
  interiorValue : ℝ → ℝ → Value
  widderVector : ℝ → Nat → BKVec
  widder_square : ∀ a n,
    widderTower baseMoment n a = Q.normSq (widderVector a n)
  reconstruct : ∀ a r,
    interiorValue a r = C.decode a r (fun n => widderTower baseMoment n a)

/-- Convert a definitionally Widder-generated BKQR model to the downstream Cayley model. -/
noncomputable def BKQRWidderGeneratedModel.toCayleyModel
    {BKVec Value : Type}
    {Q : ScalarProductGeometry ℝ BKVec}
    {C : CayleyMomentCodec ℝ Value}
    (M : BKQRWidderGeneratedModel BKVec Value Q C) :
    BKQRCayleyModel ℝ BKVec Value Q C where
  interiorValue := M.interiorValue
  widderCoeff a n := widderTower M.baseMoment n a
  widderVector := M.widderVector
  widder_square := M.widder_square
  reconstruct := M.reconstruct

/--
!! FREE-ENERGY CURVATURE BRIDGE.
Only the base moments need to be linked to free-energy curvature; higher moments
are now generated definitionally by `widderTower` on both sides.
-/
structure GPBKQRFreeEnergyCurvature
    {BKVec Value : Type}
    {G : GPObservable Value}
    {QBKQR : ScalarProductGeometry ℝ BKVec}
    {C : CayleyMomentCodec ℝ Value}
    (A : GPWidderGeneratedModel G C)
    (M : BKQRWidderGeneratedModel BKVec Value QBKQR C) where
  phiGP : ℝ → ℝ
  phiBKQR : ℝ → ℝ
  gp_base : ∀ a : ℝ,
    A.baseMoment a = 4 * logScaleCurvature phiGP a
  bkqr_base : ∀ a : ℝ,
    M.baseMoment a = 4 * logScaleCurvature phiBKQR a
  curvature_eq : ∀ y : ℝ,
    deriv (deriv phiGP) y = deriv (deriv phiBKQR) y

/-- One witness: explicit Widder-generated GP/BKQR models plus base curvature match. -/
structure GPBKQRFreeEnergyWitness
    {BKVec Value : Type}
    (G : GPObservable Value)
    (QBKQR : ScalarProductGeometry ℝ BKVec) where
  codec : CayleyMomentCodec ℝ Value
  gpModel : GPWidderGeneratedModel G codec
  bkqrModel : BKQRWidderGeneratedModel BKVec Value QBKQR codec
  freeEnergy : GPBKQRFreeEnergyCurvature gpModel bkqrModel

namespace Frontier

/--
!!! FREE-ENERGY CURVATURE FRONTIER — DEFINITIONAL WIDDER VERSION.
The former `GPBKQRSharedWidderRecursion` field has disappeared entirely.
-/
def GPBKQRFreeEnergyCurvatureFrontier
    {BKVec Value : Type}
    (G : GPObservable Value)
    (QBKQR : ScalarProductGeometry ℝ BKVec) : Prop :=
  Nonempty (GPBKQRFreeEnergyWitness G QBKQR)

end Frontier
end NativeSolobolo
