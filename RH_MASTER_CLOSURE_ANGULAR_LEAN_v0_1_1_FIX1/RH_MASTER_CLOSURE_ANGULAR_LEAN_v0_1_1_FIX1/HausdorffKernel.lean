import ScaleGeometry

namespace GPBKQRKernel

/-- Recursive signed forward difference. -/
def hdiff (c : ℕ → ℝ) : ℕ → ℕ → ℝ
  | n, 0 => c n
  | n, Nat.succ k => hdiff c n k - hdiff c (n + 1) k

@[simp] theorem hdiff_zero (c : ℕ → ℝ) (n : ℕ) :
    hdiff c n 0 = c n := rfl

@[simp] theorem hdiff_succ (c : ℕ → ℝ) (n k : ℕ) :
    hdiff c n (k + 1) = hdiff c n k - hdiff c (n + 1) k := by
  change hdiff c n (Nat.succ k) = _
  rfl

/-- Exact local Pascal split for the finite-difference lattice. -/
theorem hdiff_split (c : ℕ → ℝ) (n k : ℕ) :
    hdiff c n k = hdiff c (n + 1) k + hdiff c n (k + 1) := by
  rw [hdiff_succ]
  ring

/-- Canonical Hausdorff moment sequence generated by the symmetric contraction. -/
noncomputable def kernelMoment (sigma : ℝ) (n : ℕ) : ℝ :=
  (symmetricContraction sigma) ^ n

/-- Two-index positive BKQR/Hausdorff energy cell. -/
noncomputable def kernelEnergy (sigma : ℝ) (n k : ℕ) : ℝ :=
  (symmetricContraction sigma) ^ n *
    (1 - symmetricContraction sigma) ^ k

/-- Exact finite-difference formula for geometric moments. -/
theorem hdiff_kernelMoment (sigma : ℝ) (n k : ℕ) :
    hdiff (kernelMoment sigma) n k = kernelEnergy sigma n k := by
  induction k generalizing n with
  | zero =>
      simp [kernelMoment, kernelEnergy]
  | succ k ih =>
      rw [hdiff_succ, ih, ih]
      simp only [kernelMoment, kernelEnergy]
      rw [pow_succ (symmetricContraction sigma) n]
      rw [pow_succ (1 - symmetricContraction sigma) k]
      ring

/-- Every kernel energy cell is nonnegative, with no spectral hypothesis. -/
theorem kernelEnergy_nonneg (sigma : ℝ) (n k : ℕ) :
    0 ≤ kernelEnergy sigma n k := by
  unfold kernelEnergy
  have hq0 : 0 ≤ symmetricContraction sigma :=
    le_of_lt (symmetricContraction_pos sigma)
  have hq1 : 0 ≤ 1 - symmetricContraction sigma := by
    linarith [symmetricContraction_le_one sigma]
  positivity

/-- Exact Pascal/Hopf split of every energy cell. -/
theorem kernelEnergy_split (sigma : ℝ) (n k : ℕ) :
    kernelEnergy sigma n k =
      kernelEnergy sigma (n + 1) k + kernelEnergy sigma n (k + 1) := by
  unfold kernelEnergy
  rw [pow_succ (symmetricContraction sigma) n]
  rw [pow_succ (1 - symmetricContraction sigma) k]
  ring

/-- Unconditional Hausdorff positivity of the kernel moment sequence. -/
theorem kernelMoment_hausdorff_positive (sigma : ℝ) :
    ∀ n k : ℕ, 0 ≤ hdiff (kernelMoment sigma) n k := by
  intro n k
  rw [hdiff_kernelMoment]
  exact kernelEnergy_nonneg sigma n k

/-- Exact horizontal storage-payment ledger for the concrete kernel lattice. -/
theorem kernelEnergy_storage_ledger (sigma : ℝ) (n k m : ℕ) :
    kernelEnergy sigma n k =
      kernelEnergy sigma (n + m) k +
        Finset.sum (Finset.range m)
          (fun j => kernelEnergy sigma (n + j) (k + 1)) := by
  induction m with
  | zero => simp
  | succ m ih =>
      calc
        kernelEnergy sigma n k =
            kernelEnergy sigma (n + m) k +
              Finset.sum (Finset.range m)
                (fun j => kernelEnergy sigma (n + j) (k + 1)) := ih
        _ =
            (kernelEnergy sigma ((n + m) + 1) k +
              kernelEnergy sigma (n + m) (k + 1)) +
              Finset.sum (Finset.range m)
                (fun j => kernelEnergy sigma (n + j) (k + 1)) := by
              rw [← kernelEnergy_split sigma (n + m) k]
        _ =
            kernelEnergy sigma (n + (m + 1)) k +
              Finset.sum (Finset.range (m + 1))
                (fun j => kernelEnergy sigma (n + j) (k + 1)) := by
              rw [Finset.sum_range_succ]
              have hn : (n + m) + 1 = n + (m + 1) := by omega
              rw [hn]
              ring

/-- Total accumulated payment is bounded by the initial energy. -/
theorem kernelEnergy_total_payment_bound (sigma : ℝ) (n k m : ℕ) :
    Finset.sum (Finset.range m)
      (fun j => kernelEnergy sigma (n + j) (k + 1))
      ≤ kernelEnergy sigma n k := by
  have hid := kernelEnergy_storage_ledger sigma n k m
  have hres : 0 ≤ kernelEnergy sigma (n + m) k :=
    kernelEnergy_nonneg sigma (n + m) k
  linarith

/-- Reflection leaves every Hausdorff moment unchanged. -/
theorem kernelMoment_reflect (sigma : ℝ) (n : ℕ) :
    kernelMoment (reflect sigma) n = kernelMoment sigma n := by
  simp [kernelMoment, symmetricContraction_reflect]

/-- Reflection leaves every two-index energy cell unchanged. -/
theorem kernelEnergy_reflect (sigma : ℝ) (n k : ℕ) :
    kernelEnergy (reflect sigma) n k = kernelEnergy sigma n k := by
  simp [kernelEnergy, symmetricContraction_reflect]

end GPBKQRKernel
