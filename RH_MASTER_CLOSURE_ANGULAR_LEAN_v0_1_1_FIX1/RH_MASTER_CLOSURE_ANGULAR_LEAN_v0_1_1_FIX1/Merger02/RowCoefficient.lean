import Merger02.CoefficientTransfer
import Mathlib.RingTheory.Polynomial.Bernstein

/-!
Finite coefficient bridge from the signed Bernstein rows to the actual
jet coefficients.  This file contains only finite polynomial algebra.
-/
namespace Merger02

open Polynomial
open scoped BigOperators Polynomial

/-- Linear moment functional attached to a sequence. -/
noncomputable def momentMap (s : ℕ → ℂ) : Polynomial ℂ →ₗ[ℂ] ℂ :=
  Polynomial.lsum (fun n => (LinearMap.mul ℂ ℂ) (s n))

@[simp] theorem momentMap_monomial (s : ℕ → ℂ) (n : ℕ) (a : ℂ) :
    momentMap s ((Polynomial.monomial n) a) = a * s n := by
  simp [momentMap, mul_comm]

@[simp] theorem momentMap_X_pow (s : ℕ → ℂ) (n : ℕ) :
    momentMap s (Polynomial.X ^ n) = s n := by
  rw [Polynomial.X_pow_eq_monomial]
  simp

/-- The finite differences occurring in the rows are exactly the moments of
`X^j (1-X)^k`. -/
theorem momentMap_X_pow_mul_one_sub_X_pow (s : ℕ → ℂ) (k j : ℕ) :
    momentMap s (Polynomial.X ^ j * (1 - Polynomial.X) ^ k) =
      differenceSum s k j := by
  induction k generalizing j with
  | zero =>
      simp [differenceSum]
  | succ k ih =>
      have hpoly :
          (Polynomial.X : Polynomial ℂ) ^ j * ((1 : Polynomial ℂ) - Polynomial.X) ^ (k + 1) =
            (Polynomial.X : Polynomial ℂ) ^ j * ((1 : Polynomial ℂ) - Polynomial.X) ^ k -
              (Polynomial.X : Polynomial ℂ) ^ (j + 1) * ((1 : Polynomial ℂ) - Polynomial.X) ^ k := by
        rw [pow_succ]
        ring
      rw [hpoly, map_sub, ih, ih, differenceSum_succ]

/-- Each project row coefficient is the moment of the corresponding Bernstein
basis polynomial. -/
theorem momentMap_bernsteinPolynomial (s : ℕ → ℂ) (N j : ℕ) :
    momentMap s (bernsteinPolynomial ℂ N j) = row s N j := by
  by_cases hj : j ≤ N
  · rw [bernsteinPolynomial]
    have hscalar :
        ((N.choose j : Polynomial ℂ) * Polynomial.X ^ j *
            (1 - Polynomial.X) ^ (N - j)) =
          (N.choose j : ℂ) •
            (Polynomial.X ^ j * (1 - Polynomial.X) ^ (N - j)) := by
      simp [Polynomial.smul_eq_C_mul, mul_assoc]
    rw [hscalar, map_smul, momentMap_X_pow_mul_one_sub_X_pow]
    rfl
  · have hlt : N < j := Nat.lt_of_not_ge hj
    simp [bernsteinPolynomial, row, Nat.choose_eq_zero_of_lt hlt]

/-- The weighted Bernstein basis sums to the binomial polynomial which exposes
`(z-1)^r`. -/
theorem weighted_bernstein_sum (N : ℕ) (z : ℂ) :
    (∑ j ∈ Finset.range (N + 1),
        Polynomial.C (z ^ j) * bernsteinPolynomial ℂ N j) =
      (1 + Polynomial.C (z - 1) * Polynomial.X) ^ N := by
  calc
    (∑ j ∈ Finset.range (N + 1),
        Polynomial.C (z ^ j) * bernsteinPolynomial ℂ N j) =
      (Polynomial.C z * Polynomial.X + (1 - Polynomial.X)) ^ N := by
        rw [add_pow]
        apply Finset.sum_congr rfl
        intro j hj
        simp only [bernsteinPolynomial, map_pow]
        ring
    _ = (1 + Polynomial.C (z - 1) * Polynomial.X) ^ N := by
      congr 1
      simp only [map_sub, map_one]
      ring

/-- Finite row reindexing: the polynomial generated by the signed Bernstein row
is exactly the binomial transform of the actual moment jet. -/
theorem rowPolynomial_reindex (s : ℕ → ℂ) (N : ℕ) (z : ℂ) :
    rowPolynomial s N z =
      ∑ r ∈ Finset.range (N + 1),
        (N.choose r : ℂ) * s r * (z - 1) ^ r := by
  have hleft :
      momentMap s
          (∑ j ∈ Finset.range (N + 1),
            Polynomial.C (z ^ j) * bernsteinPolynomial ℂ N j) =
        rowPolynomial s N z := by
    rw [map_sum]
    unfold rowPolynomial
    apply Finset.sum_congr rfl
    intro j hj
    rw [← Polynomial.smul_eq_C_mul]
    rw [map_smul, momentMap_bernsteinPolynomial]
    simp [smul_eq_mul, mul_comm]
  rw [← hleft, weighted_bernstein_sum]
  have hbinom :
      momentMap s ((1 + Polynomial.C (z - 1) * Polynomial.X) ^ N) =
        ∑ r ∈ Finset.range (N + 1),
          (N.choose r : ℂ) * s r * (z - 1) ^ r := by
    rw [add_comm, add_pow, map_sum]
    apply Finset.sum_congr rfl
    intro r hr
    have hterm :
        (Polynomial.C (z - 1) * Polynomial.X) ^ r *
              (1 : Polynomial ℂ) ^ (N - r) * (N.choose r : Polynomial ℂ) =
          ((N.choose r : ℂ) * (z - 1) ^ r) • (Polynomial.X ^ r) := by
      simp only [one_pow, mul_one, mul_pow, map_pow]
      simp [Polynomial.smul_eq_C_mul, mul_assoc, mul_comm, mul_left_comm]
    rw [hterm, map_smul, momentMap_X_pow]
    simp [smul_eq_mul, mul_assoc, mul_comm, mul_left_comm]
  exact hbinom

/-- The actual row is therefore tied to the actual derivative jet without an
abstract coefficient sequence. -/
theorem actualRowPolynomial_reindex (N : ℕ) (z : ℂ) :
    rowPolynomial actualJet N z =
      ∑ r ∈ Finset.range (N + 1),
        (N.choose r : ℂ) * actualJet r * (z - 1) ^ r :=
  rowPolynomial_reindex actualJet N z

end Merger02
